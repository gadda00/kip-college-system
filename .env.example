# KIP College — environment configuration
# Copy to `.env` and adjust before running locally:  cp .env.example .env
# (Create it BEFORE `bun install` so postinstall generates the SQLite client.)

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (required)
# ─────────────────────────────────────────────────────────────────────────────
# Local development: SQLite — zero-config, uses the bundled seeded database.
# Relative paths resolve the way the Prisma CLI does ("file:../db/custom.db"
# relative to prisma/ also works).
DATABASE_URL=file:./db/custom.db

# Production (Vercel / Netlify / self-hosted): a PostgreSQL connection string —
# Prisma Postgres or any managed Postgres (Neon, Supabase, RDS…):
#   DATABASE_URL=prisma://user:password@host/db
#   DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# On serverless hosts DATABASE_URL MUST be set (falling back to the bundled
# SQLite file is read-only there → /api/health returns 503). The first request
# against an empty PostgreSQL database auto-creates all tables and seeds the
# demo dataset — no migration step. See DEPLOYMENT.md.

# ─────────────────────────────────────────────────────────────────────────────
# DEMO MODE (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Show the one-click demo account helper on the login screen.
# Only enable for evaluation/demo deployments — NEVER in production.
# Demo credentials: admin@kipskitui.com / Admin@123 · lecturer@kipskitui.com /
# Lecturer@123 · student@kipskitui.com / Student@123
NEXT_PUBLIC_DEMO_MODE=0
