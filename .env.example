# KIP College — environment configuration
# Copy to .env and adjust before running locally.

# SQLite database (demo / local development).
# Use an ABSOLUTE path for local runs; the app also resolves paths relative
# to the project root ("file:./db/custom.db") or relative to prisma/
# ("file:../db/custom.db").
#
# Examples:
#   DATABASE_URL=file:/absolute/path/to/kip-college-system/db/custom.db
#   DATABASE_URL=file:./db/custom.db
DATABASE_URL=file:./db/custom.db

# Serverless demo deployment (Vercel / Netlify) — writable ephemeral storage:
#   DATABASE_URL=file:/tmp/custom.db
# (src/instrumentation.ts copies the bundled seed database there on cold start.)

# Production — switch prisma/schema.prisma provider to "postgresql" and use:
#   DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# See DEPLOYMENT.md for the full production guide.
