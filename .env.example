# KIP College — environment configuration
# Copy to `.env` and adjust before running locally:  cp .env.example .env

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (required)
# ─────────────────────────────────────────────────────────────────────────────
# SQLite for local / demo use. Relative paths resolve against the project root;
# "file:../db/custom.db" (relative to prisma/) also works for Prisma CLI parity.
DATABASE_URL=file:./db/custom.db

# Serverless demo deployment (Vercel / Netlify): writable ephemeral storage.
# The app auto-detects Vercel/Netlify when DATABASE_URL is unset and does this
# automatically — zero configuration. Explicit form if you prefer:
#   DATABASE_URL=file:/tmp/custom.db

# Production: switch prisma/schema.prisma provider to "postgresql", then use
#   DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# See DEPLOYMENT.md for the full production guide (Neon / Supabase free tiers).

# ─────────────────────────────────────────────────────────────────────────────
# DEMO MODE (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Show the one-click demo account helper on the login screen.
# Only enable for evaluation/demo deployments — NEVER in production.
# Demo credentials: admin@kipskitui.com / Admin@123 · lecturer@kipskitui.com /
# Lecturer@123 · student@kipskitui.com / Student@123
NEXT_PUBLIC_DEMO_MODE=0
